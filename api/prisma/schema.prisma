generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          String   @id @default(uuid())
  name        String
  description String
  prepTime    Int
}

model Ingredient {
  id          String    @id @default(uuid())
  name        String
  defaultUnit String
  products    Product[]
}

model Product {
  id           String      @id @default(uuid())
  name         String
  brand        String?
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
}