generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id                String             @id @default(uuid())
  name              String
  description       String
  prepTime          Int
  servings          Int                @default(1)
  recipeIngredients RecipeIngredient[]
  mealItems         MealItem[]
}

model Ingredient {
  id                String             @id @default(uuid())
  name              String
  defaultUnit       String
  products          Product[]
  recipeIngredients RecipeIngredient[]
  mealItems         MealItem[]
  inventoryItems    InventoryItem[]
  shoppingItems     ShoppingItem[]
  nutrition         Nutrition?
}

model RecipeIngredient {
  id           String @id @default(uuid())
  recipeId     String
  ingredientId String
  quantity     Float
  unit         String

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([ingredientId])
}

model Product {
  id             String          @id @default(uuid())
  name           String
  brand          String?
  ingredientId   String?
  ingredient     Ingredient?     @relation(fields: [ingredientId], references: [id])
  mealItems      MealItem[]
  inventoryItems InventoryItem[]
  shoppingItems  ShoppingItem[]
  nutrition      Nutrition?
}

enum MealItemType {
  recipe
  ingredient
  product
}

model Meal {
  id        String         @id @default(uuid())
  name      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     MealItem[]
  planItems MealPlanItem[]
}

model MealItem {
  id              String               @id @default(uuid())
  mealId          String
  type            MealItemType
  recipeId        String?
  ingredientId    String?
  productId       String?
  quantity        Float?
  unit            String?
  servings        Float?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  shoppingSources ShoppingItemSource[]

  meal       Meal        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  recipe     Recipe?     @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([mealId])
  @@index([recipeId])
  @@index([ingredientId])
  @@index([productId])
}

enum MealMoment {
  breakfast
  lunch
  dinner
  snack
}

model MealPlan {
  id            String         @id @default(uuid())
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         MealPlanItem[]
  shoppingItems ShoppingItem[]
}

model MealPlanItem {
  id         String     @id @default(uuid())
  mealPlanId String
  mealId     String
  date       DateTime   @db.Date
  moment     MealMoment
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  meal     Meal     @relation(fields: [mealId], references: [id], onDelete: Restrict)

  @@index([mealPlanId])
  @@index([mealId])
  @@index([date])
}

model InventoryItem {
  id           String   @id @default(uuid())
  ingredientId String?
  productId    String?
  quantity     Float
  unit         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([ingredientId])
  @@index([productId])
}

enum ShoppingItemSourceType {
  meal_plan
  manual
}

model ShoppingItem {
  id           String   @id @default(uuid())
  mealPlanId   String?
  name         String
  ingredientId String?
  productId    String?
  quantity     Float
  unit         String
  checked      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredient Ingredient?          @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  product    Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)
  mealPlan   MealPlan?            @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  sources    ShoppingItemSource[]

  @@index([ingredientId])
  @@index([productId])
  @@index([mealPlanId])
}

model ShoppingItemSource {
  id             String                 @id @default(uuid())
  shoppingItemId String
  type           ShoppingItemSourceType
  mealItemId     String?
  quantity       Float
  unit           String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  shoppingItem ShoppingItem @relation(fields: [shoppingItemId], references: [id], onDelete: Cascade)
  mealItem     MealItem?    @relation(fields: [mealItemId], references: [id], onDelete: SetNull)

  @@index([shoppingItemId])
  @@index([mealItemId])
}

enum NutritionBasisUnit {
  g
  ml
}

model Nutrition {
  id            String             @id @default(uuid())
  basisQuantity Float
  basisUnit     NutritionBasisUnit
  calories      Float?
  protein       Float?
  carbohydrates Float?
  fat           Float?
  fiber         Float?
  sugar         Float?
  saturatedFat  Float?
  salt          Float?
  ingredientId  String?            @unique
  productId     String?            @unique

  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
}
